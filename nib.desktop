[Desktop Entry]
Type=Application
Name=nib
GenericName=Web Browser
Comment=Minimal keyboard-driven browser on a Chromium backend
Exec=nib %U
Icon=web-browser
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
StartupNotify=true
